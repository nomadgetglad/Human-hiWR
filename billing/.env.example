# Copy to billing/.env (never committed) and fill in. TEST keys only until you decide to go live.
# Best: a restricted key (rk_test_...) from Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=rk_test_replace_me
# From `stripe listen --forward-to localhost:8100/billing/webhook` (local) or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace_me
BILLING_PUBLIC_URL=http://localhost:8100

# Who runs billing. name:token pairs, comma separated. Make a token with: python -m billing.config
# Refunds need two of these people, and never the one who asked.
BILLING_ADMINS=alexandre:replace_with_40_char_token,dad:replace_with_another_40_char_token

# Prices in cents. SAMPLE numbers for the sandbox; the proposal leaves the real ones blank.
BILLING_PRICE_MONTHLY_CENTS=19900
BILLING_PRICE_MODULE_CENTS=4900
BILLING_PRICE_LOCATION_CENTS=7900
BILLING_PRICE_SETUP_CENTS=150000

# Stripe Tax. Product tax codes are your (and your tax advisor's) call; candidates in README.md.
BILLING_TAX_CODE_MONTHLY=
BILLING_TAX_CODE_SETUP=
# exclusive = tax added on top of the price, inclusive = price already includes tax
BILLING_TAX_BEHAVIOR=exclusive
